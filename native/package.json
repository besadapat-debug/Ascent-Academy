{
  "name": "ascent-academy-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Ascent Academy desktop (Windows, macOS) and mobile (Android, iOS) apps",
  "author": "Ascent Academy",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "cap:android": "cap add android && capacitor-assets generate --android && cap sync android",
    "cap:ios": "cap add ios && capacitor-assets generate --ios && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ascentacademy.app",
    "productName": "Ascent Academy",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**", "app.config.json", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.education", "icon": "build/icon.png" }
  }
}
